  "keywords": [
    "dsh-plugin",
    "ego-browser",
    "skill",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrus-xc/ego_lite_for_DSH.git"
  },
  "license": "MIT"
