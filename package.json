{
  "name": "dsh-ego-lite",
  "version": "0.2.0",
  "description": "Official-style ego-browser Skill provider for DeepSeek Harness",
  "type": "module",
  "main": "./dsh/src/index.js",
  "exports": {
    ".": "./dsh/src/index.js",
    "./dsh": "./dsh/src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSE.txt",
    "UPSTREAM.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none"
