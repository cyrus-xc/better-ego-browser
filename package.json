{
  "name": "@cyrusxc5/better-ego-browser",
  "version": "0.3.3",
  "description": "better-ego-browser: connect DeepSeek Harness to the official Windows ego lite app over authenticated loopback HTTP",
  "type": "module",
  "main": "./dsh/plugin.mjs",
  "exports": {
    ".": "./dsh/plugin.mjs",
    "./dsh": "./dsh/plugin.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "skills",
    "docs/images",
    "docs/demo.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_LICENSE.txt",
    "UPSTREAM.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "keywords": [
    "dsh-plugin",
    "better-ego-browser",
    "ego-browser",
    "skill",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrus-xc/better-ego-browser.git"
  },
  "homepage": "https://github.com/cyrus-xc/better-ego-browser#readme",
  "bugs": {
    "url": "https://github.com/cyrus-xc/better-ego-browser/issues"
  },
  "author": "cyrus-xc",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2 || >=0.2.1-0 || >=0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
